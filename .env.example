# =========================================================
#  timvideo - environment variables
#  Copy file này thành `.env.local` và điền giá trị thật.
#  TUYỆT ĐỐI KHÔNG commit file .env.local chứa secret thật.
# =========================================================

# ---------- Supabase ----------
# Lấy ở: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - CHỈ dùng phía server, KHÔNG bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------- Google Drive (Service Account) ----------
# Tạo service account trong Google Cloud Console, bật Google Drive API,
# share folder Drive cho email service account quyền Editor.
GOOGLE_DRIVE_CLIENT_EMAIL=service-account@your-gcp-project.iam.gserviceaccount.com
# Private key dạng 1 dòng, giữ ký tự \n. Bọc trong dấu nháy kép.
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ID folder Drive đích (lấy từ URL folder: drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ---------- App ----------
# Danh sách email admin, ngăn cách bởi dấu phẩy.
# Các email này tự động được nâng quyền 'admin' ngay khi đăng nhập lần đầu.
ADMIN_EMAILS=admin@example.com
